{
  "manifest_version": 3,
  "name": "TubeList",
  "version": "0.4.0",
  "description": "Save YouTube videos, playlists and queues into local playlists.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tubelist@tubelist.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["browsingActivity"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["contextMenus", "storage", "declarativeNetRequestWithHostAccess", "scripting", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/embed/*"], "js": ["frame.js"], "all_frames": true, "run_at": "document_start" }],
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
